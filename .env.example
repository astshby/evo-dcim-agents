# 本文件不包含真实凭据。复制到EvoTest目录的.env后由用户自行填写。
# 原版EvoTest读取OPENAI_API_KEY，但服务地址默认OpenRouter。
OPENAI_API_KEY=
# 只有运行scripts/patch_evotest_backend.py之后，这个变量才生效。
LLM_BASE_URL=https://openrouter.ai/api/v1
# run_evotest_baseline.sh 要求从当前shell显式提供模型ID。
EVOTEST_ACTOR_MODEL=
EVOTEST_EVOLVER_MODEL=

# 未来统一embedding客户端的建议变量；原JitRL代码不识别这些字段。
# 原JitRL使用OPENAI_API_KEY2直连OpenAI embedding；不要静默借用对话密钥。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
